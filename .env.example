# Copy to .env (gitignored). Real environment variables take precedence.

# Needed for the Ask page and `munim ask`. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Which model writes the SQL.
# MUNIM_MODEL=claude-sonnet-5-5

# Optional. Set to 0 to stop sending frequent merchant names to the model.
# MUNIM_SEND_MERCHANTS=1

# Optional. Where the database and archived uploads live (default: ./data).
# MUNIM_DATA_DIR=
