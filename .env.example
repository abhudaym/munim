# Copy to .env (gitignored). Real environment variables take precedence.

# Which model answers the Ask page and `munim ask`. Pick one block.

# 1. Ollama: free, runs on this machine, nothing leaves it.
#    Install from https://ollama.com, then: ollama pull qwen2.5-coder:7b
# MUNIM_PROVIDER=ollama
# MUNIM_MODEL=qwen2.5-coder:7b

# 2. Groq: free tier, hosted. Key and model ids at https://console.groq.com
# MUNIM_PROVIDER=groq
# GROQ_API_KEY=
# MUNIM_MODEL=

# 3. Claude: paid. Key at https://console.anthropic.com
# MUNIM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MUNIM_MODEL=claude-sonnet-5-5

# 4. Anything else that speaks the OpenAI chat API.
# MUNIM_PROVIDER=openai-compatible
# MUNIM_BASE_URL=
# MUNIM_API_KEY=
# MUNIM_MODEL=

# Optional. Set to 0 to stop sending frequent merchant names to a hosted model.
# MUNIM_SEND_MERCHANTS=1

# Optional. Where the database and archived uploads live (default: ./data).
# MUNIM_DATA_DIR=
